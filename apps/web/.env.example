# Server-only secrets stay unprefixed.
# NEXT_PUBLIC_SENTRY_DSN is the one exception: a Sentry DSN is a public
# project identifier, not a credential. It is required when VERCEL_ENV is
# preview or production.

# Optional. Building and exporting a resume works without it.
# OPENAI_API_KEY=

# Required on Vercel preview and production builds.
# NEXT_PUBLIC_SENTRY_DSN=

# Build-time source map upload. Never expose these to the browser.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Local docker compose (repo root) uses the same URL for both.
# On Neon, DATABASE_URL is the pooled string and DATABASE_URL_UNPOOLED
# is the direct string used by migrations.
# DATABASE_URL=postgres://winnow:winnow@localhost:5432/winnow
# DATABASE_URL_UNPOOLED=postgres://winnow:winnow@localhost:5432/winnow
